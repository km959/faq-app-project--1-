import os
import uuid
import requests
import re
from fastapi import APIRouter, Depends
from sqlalchemy import text
from sqlalchemy.orm import Session

from database import get_db
import models
import schemas
from auth import get_current_user

import re

GREETING_PATTERN = re.compile(
    r"^\s*(hi|hii|hiii|hello|hey|heyy|good\s?morning|good\s?afternoon|good\s?evening|yo|sup)\s*[!.]?\s*$",
    re.IGNORECASE,
)

THANKS_PATTERN = re.compile(
    r"^\s*(thanks|thank you|thankyou|ty|ok|okay|cool|great)\s*[!.]?\s*$",
    re.IGNORECASE,
)

router = APIRouter(prefix="/chat", tags=["chat"])

GEMINI_API_KEY = os.getenv("GEMINI_API_KEY", "")
GEMINI_URL = "https://generativelanguage.googleapis.com/v1beta/models/gemini-3.7-flash:generateContent"
FAQ_CONFIDENCE_THRESHOLD = 0.15
SUGGESTION_THRESHOLD = 0.03


CATEGORY_KEYWORDS = {
    "billing": "Billing",
    "payment": "Billing",
    "subscription": "Billing",
    "profile": "Personal",
    "account": "Account",
    "job": "Jobs",
    "jobs": "Jobs",
}


STOPWORDS = {
    "how", "is", "are", "the", "a", "an", "to", "for", "of", "do", "does",
    "i", "can", "you", "your", "my", "what", "when", "where", "why", "who",
    "in", "on", "at", "and", "or", "please", "me", "it", "this", "that",
    "ur", "u", "am", "was", "were", "be", "will", "would", "should",
}


def categorize_subject(query: str) -> str:
    q = query.lower()

    if any(
        word in q
        for word in [
            "bill",
            "payment",
            "subscription",
            "invoice",
            "salary",
            "charge",
        ]
    ):
        return "Billing"

    if any(
        word in q
        for word in [
            "profile",
            "photo",
            "picture",
            "update my",
        ]
    ):
        return "Profile"

    if any(
        word in q
        for word in [
            "account",
            "delete",
            "password",
            "login",
            "signup",
            "mobile number",
            "email",
        ]
    ):
        return "Account"

    if any(
        word in q
        for word in [
            "apply",
            "application",
            "recommend",
            "hiring",
            "hire",
        ]
    ):
        return "Jobs"

    words = [w.strip(".,!?") for w in query.split()]
    keywords = [
        w
        for w in words
        if w.lower() not in STOPWORDS and len(w) > 2
    ]

    if keywords:
        return " ".join(w.capitalize() for w in keywords[:3])

    return "General Support"


def search_knowledge_base(db: Session, query: str):
    # Handle common typo in password-reset questions
    query = re.sub(
        r"\brest\s+password\b",
        "reset password",
        query,
        flags=re.IGNORECASE,
    )

    result = db.execute(
        text(
            """
            SELECT id, category, question, answer,
                   ts_rank(
                       to_tsvector('english', question || ' ' || answer),
                       plainto_tsquery('english', :q)
                   ) AS rank
            FROM knowledge_base
            WHERE to_tsvector(
                'english',
                question || ' ' || answer
            ) @@ plainto_tsquery('english', :q)
            ORDER BY rank DESC
            LIMIT 3
            """
        ),
        {"q": query},
    ).fetchall()

    return result


def get_faq_by_exact_question(db: Session, question: str):
    row = db.execute(
        text(
            """
            SELECT id, category, question, answer
            FROM knowledge_base
            WHERE lower(question) = lower(:q)
            LIMIT 1
            """
        ),
        {"q": question.strip()},
    ).fetchone()

    return row


def ask_gemini(
    query: str,
    context_faqs: list,
    history: list,
    retries: int = 1,
):
    if not GEMINI_API_KEY:
        print("GEMINI: no API key set")
        return None

    context_text = (
        "\n\n".join(
            f"Q: {row.question}\nA: {row.answer}"
            for row in context_faqs
        )
        if context_faqs
        else "(no closely related FAQ found)"
    )

    instructions = f"""You are a support assistant for this healthcare job platform.
Some possibly related FAQs are shown below for reference, but you are not limited to them.
The conversation so far is included above this message. If the user's question is a
follow-up (like "explain step 2" or "what about that"), find the relevant part of your
own PREVIOUS answer in the conversation and explain it further — do not say NOT_FOUND
just because the question alone seems vague; use the conversation context to understand it.
Only reply with exactly NOT_FOUND if the question is truly unrelated to this platform,
jobs, or support, even after considering the conversation.

Related FAQs:
{context_text}

User question: {query}

Answer:"""

    contents = []

    for turn in (history or []):
        role = "model" if turn.role == "assistant" else "user"

        contents.append(
            {
                "role": role,
                "parts": [{"text": turn.text}],
            }
        )

    contents.append(
        {
            "role": "user",
            "parts": [{"text": instructions}],
        }
    )

    attempts = retries + 1

    for attempt in range(attempts):
        try:
            resp = requests.post(
                GEMINI_URL,
                headers={"x-goog-api-key": GEMINI_API_KEY},
                json={"contents": contents},
                timeout=30,
            )

            resp.raise_for_status()

            data = resp.json()

            text_out = (
                data["candidates"][0]["content"]["parts"][0]["text"]
                .strip()
            )

            print("GEMINI RAW RESPONSE:", text_out)

            if "NOT_FOUND" in text_out:
                return None

            return text_out

        except Exception as e:
            print(
                f"GEMINI ERROR (attempt {attempt + 1}/{attempts}):",
                repr(e),
            )

            if attempt == attempts - 1:
                return None

    return None


def get_category_suggestions(db: Session, query: str):
    key = query.strip().lower()
    category = CATEGORY_KEYWORDS.get(key)

    if not category:
        return None

    rows = db.execute(
        text(
            """
            SELECT question
            FROM knowledge_base
            WHERE category = :cat
            LIMIT 5
            """
        ),
        {"cat": category},
    ).fetchall()

    return [r.question for r in rows] if rows else None


def get_related_questions(
    db: Session,
    category: str,
    exclude_question: str = None,
):
    if not category:
        return []

    rows = db.execute(
        text(
            """
            SELECT question
            FROM knowledge_base
            WHERE category = :cat
              AND question != :exclude
            ORDER BY random()
            LIMIT 3
            """
        ),
        {
            "cat": category,
            "exclude": exclude_question or "",
        },
    ).fetchall()

    return [r.question for r in rows]


@router.post("/ask", response_model=schemas.ChatResponse)
def ask_chat(
    payload: schemas.ChatQuery,
    db: Session = Depends(get_db),
    current_user: models.User = Depends(get_current_user),
):
    if GREETING_PATTERN.match(payload.query):
        return schemas.ChatResponse(
            source="greeting",
            answer="Hi there! I'm here to help. Ask me anything about jobs, your profile, billing, or account settings.",
        )

    if THANKS_PATTERN.match(payload.query):
        return schemas.ChatResponse(
            source="greeting",
            answer="You're welcome! Let me know if there's anything else I can help with.",
        )

    category_suggestions = get_category_suggestions(db, payload.query)

    if category_suggestions:
        return schemas.ChatResponse(
            source="suggestions",
            answer="Looking for something specific? Here are some related questions",
            suggestions=category_suggestions,
        )

    if payload.is_suggestion:
        exact = get_faq_by_exact_question(db, payload.query)

        if exact:
            related = get_related_questions(
                db,
                exact.category,
                exact.question,
            )

            return schemas.ChatResponse(
                source="faq",
                answer=exact.answer,
                matched_question=exact.question,
                related_label="Looking for something specific? Here are some related questions"
                if related
                else None,
                related_questions=related if related else None,
            )

    is_followup = (
        bool(payload.history)
        and len(payload.history) > 0
        and not payload.is_suggestion
    )

    if not is_followup:
        exact = get_faq_by_exact_question(db, payload.query)

        if exact:
            related = get_related_questions(
                db,
                exact.category,
                exact.question,
            )

            return schemas.ChatResponse(
                source="faq",
                answer=exact.answer,
                matched_question=exact.question,
                related_label="Looking for something specific? Here are some related questions"
                if related
                else None,
                related_questions=related if related else None,
            )

        # ---------------------------------------------------------
        # PASSWORD FAQ FALLBACK
        # This handles password questions before Gemini is called.
        # It also handles common wording such as "rest password".
        # ---------------------------------------------------------
        normalized_query = payload.query.lower()

        if (
            "password" in normalized_query
            and any(
                word in normalized_query
                for word in [
                    "reset",
                    "rest",
                    "forgot",
                    "change",
                    "update",
                ]
            )
        ):
            password_faq = db.execute(
                text(
                    """
                    SELECT id, category, question, answer
                    FROM knowledge_base
                    WHERE category = 'Account'
                      AND (
                          lower(question) LIKE '%password%'
                          OR lower(answer) LIKE '%password%'
                      )
                    ORDER BY
                        CASE
                            WHEN lower(question) LIKE '%reset%' THEN 1
                            ELSE 2
                        END
                    LIMIT 1
                    """
                )
            ).fetchone()

            if password_faq:
                related = get_related_questions(
                    db,
                    password_faq.category,
                    password_faq.question,
                )

                return schemas.ChatResponse(
                    source="faq",
                    answer=password_faq.answer,
                    matched_question=password_faq.question,
                    related_label="Looking for something specific? Here are some related questions"
                    if related
                    else None,
                    related_questions=related if related else None,
                )

        matches = search_knowledge_base(db, payload.query)

        if matches and matches[0].rank >= FAQ_CONFIDENCE_THRESHOLD:
            top = matches[0]

            related = get_related_questions(
                db,
                top.category,
                top.question,
            )

            return schemas.ChatResponse(
                source="faq",
                answer=top.answer,
                matched_question=top.question,
                related_label="Looking for something specific? Here are some related questions"
                if related
                else None,
                related_questions=related if related else None,
            )

        if matches and matches[0].rank >= SUGGESTION_THRESHOLD:
            return schemas.ChatResponse(
                source="suggestions",
                answer="We weren't exactly sure what you were looking for, but these are some close matches",
                suggestions=[m.question for m in matches],
            )

    else:
        matches = search_knowledge_base(db, payload.query)

    ai_answer = ask_gemini(
        payload.query,
        matches if matches else [],
        payload.history,
    )

    if ai_answer:
        fallback_category = matches[0].category if matches else None

        related = (
            get_related_questions(db, fallback_category)
            if fallback_category
            else []
        )

        return schemas.ChatResponse(
            source="ai",
            answer=ai_answer,
            related_label="Looking for something specific? Here are some related questions"
            if related
            else None,
            related_questions=related if related else None,
        )

    ticket = models.Ticket(
        user_id=current_user.id,
        contact_name=current_user.name or "User",
        contact_email=current_user.email,
        contact_phone=current_user.phone,
        subject=categorize_subject(payload.query),
        description=payload.query,
        status="open",
    )

    db.add(ticket)
    db.commit()
    db.refresh(ticket)

    return schemas.ChatResponse(
        source="ticket",
        answer="I couldn't find a confident answer to that. I've raised a support ticket so our team can help you directly.",
        ticket=schemas.TicketOut.model_validate(ticket),
    )
